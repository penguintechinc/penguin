<?xml version="1.0" encoding="UTF-8"?>
<!-- penguind system daemon for macOS (Rust). Install to
     /Library/LaunchDaemons/io.penguintech.penguind.plist and load with
     `sudo launchctl load -w <path>`. Runs as root (hardened runtime) because
     tunnel + resolver management require it on macOS.

     This is the plist `penguind service install` writes verbatim, embedded
     into the binary via `include_str!` — see
     `bins/penguind/src/service/mod.rs`. Ported from
     `go-client/packaging/launchd/io.penguintech.penguind.plist`, whose
     contents this file matches exactly; the Rust binary shares the same
     install path and CLI flags. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.penguintech.penguind</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/penguind</string>
        <string>--config-dir</string>
        <string>/etc/penguin</string>
        <string>--state-dir</string>
        <string>/var/lib/penguind</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Self-protection auto-restart: always restart on exit -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardErrorPath</key>
    <string>/var/log/penguind.log</string>
    <key>StandardOutPath</key>
    <string>/var/log/penguind.log</string>
</dict>
</plist>
