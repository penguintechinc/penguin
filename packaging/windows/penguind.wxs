<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v5 installer for the Penguin Endpoint Agent (penguind daemon + penguin CLI),
  Rust build. Ported from go-client/packaging/windows/penguind.wxs — the
  directives below match that file line-for-line; only the staging-source
  comment changed (cargo output, not `go build` output).

  penguin-tray is deliberately NOT included in this MSI, matching the Go
  reference's decision: tray is still released separately (raw .exe per
  .github/workflows/release-tray.yml), same as Go shipped it. Revisit once
  tray has its own Windows startup/service integration story.

  Build (must run on Windows — WiX parses/links anywhere, but the MSI Bind phase
  P/Invokes the Windows-only msi.dll, so emitting the .msi requires windows-latest;
  see .github/workflows/release-windows-msi.yml):
    wix build packaging/windows/penguind.wxs \
      -d Version=<x.y.z> -b <dir-with-exes> -arch x64 -o penguind.msi

  The staging dir passed with -b must contain penguind.exe and penguin.exe:
  a release-profile `cargo build` for target x86_64-pc-windows-msvc, copied
  there by the release-windows-msi workflow (not GOOS=windows/CGO_ENABLED=0
  as the Go build produced them).

  TODO(signing): the produced MSI is UNSIGNED. Sign before distribution with:
    signtool.exe sign /fd SHA256 /f cert.pfx /p <pw> /tr <timestamp-url> /td SHA256 penguind.msi
  Requires an Authenticode code-signing certificate (out of scope for this build).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Penguin Endpoint Agent"
           Manufacturer="PenguinTech"
           Version="$(Version)"
           UpgradeCode="9A8351D8-A9FC-4FDA-9EAA-AE4ED4369077"
           Scope="perMachine">

    <!-- Same UpgradeCode as the frozen Go MSI (go-client/packaging/windows/penguind.wxs)
         deliberately kept identical: this is a rewrite of the same product, not a
         new one, so MajorUpgrade below removes a machine's existing Go-built
         install (or an older Rust one) in place rather than leaving two side by
         side. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />

    <!-- Embed a single cab inside the MSI (no external media). -->
    <MediaTemplate EmbedCab="yes" />

    <!-- Install both executables into %ProgramFiles%\Penguin (64-bit). -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Penguin">

        <!-- Daemon: installed AND registered as a Windows service via the SCM. -->
        <Component Id="penguind_exe" Bitness="always64">
          <File Id="penguind_exe" Source="penguind.exe" KeyPath="yes" />
          <ServiceInstall Id="PenguindServiceInstall"
                          Type="ownProcess"
                          Name="penguind"
                          DisplayName="Penguin Daemon"
                          Description="PenguinTech unified endpoint agent daemon"
                          Start="auto"
                          Account="LocalSystem"
                          ErrorControl="normal" />
          <ServiceControl Id="PenguindServiceControl"
                          Name="penguind"
                          Stop="both"
                          Remove="uninstall"
                          Wait="yes" />
        </Component>

        <!-- CLI: installed to the same directory (no service). -->
        <Component Id="penguin_exe" Bitness="always64">
          <File Id="penguin_exe" Source="penguin.exe" KeyPath="yes" />
        </Component>

      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="Penguin Endpoint Agent" Level="1">
      <ComponentRef Id="penguind_exe" />
      <ComponentRef Id="penguin_exe" />
    </Feature>

  </Package>
</Wix>
